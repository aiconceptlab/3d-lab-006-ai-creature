# Keep credentials on the server. Never use a VITE_ prefix for a secret.
PORT=3019
HOST=127.0.0.1
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3500
# Required for public deployment: long random value. Visitors enter it once.
ACCESS_CODE=
# 0 keeps local rule-based demo usable without a key; 1 fails instead of fallback.
REQUIRE_JEV=0
# Optional paid image-to-3D upgrade. Initial creation uses Jev + procedural geometry.
TRIPO_API_KEY=
TRIPO_IMAGE_MODEL=chat_image_2.5_flare
TRIPO_MESH_MODEL=P1-20260311
ENABLE_TRIPO=0
# Store outside the public folder; gitignored by default.
DATA_DIR=.data
