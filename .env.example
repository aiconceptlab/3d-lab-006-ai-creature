# Keep credentials on the server. Never use a VITE_ prefix for a secret.
PORT=3019
HOST=0.0.0.0
TYPESAFE_API_KEY=
# Choose typesafe for console.typesafe.ai keys, or jev-ai for jev-ai.pro keys.
JEV_PROVIDER=typesafe
JEV_AI_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3500
# Share paid AI actions on the LAN only with a long random access code.
# Included pets and local behaviour work without one.
ACCESS_CODE=
# 0 keeps local rule-based demo usable without a key; 1 fails instead of fallback.
REQUIRE_JEV=0
# Optional paid image-to-3D creation. Included sample models need no API key.
TRIPO_API_KEY=
TRIPO_IMAGE_MODEL=chat_image_2.5_flare
TRIPO_MESH_MODEL=v3.1-20260211
ENABLE_TRIPO=0
# Store outside the public folder; gitignored by default.
DATA_DIR=.data
